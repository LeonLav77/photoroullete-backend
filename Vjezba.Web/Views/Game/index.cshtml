@model IEnumerable<Vjezba.Model.Game>

@{
    ViewData["Title"] = "Games";
    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Manager");
    bool isAuthenticated = User.Identity.IsAuthenticated;
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2>
                <i class="fas fa-gamepad text-primary"></i> Games History
            </h2>
            @if (isAuthenticated)
            {
                <div>
                    <span class="badge bg-info me-2">
                        @if (isAdmin)
                        {
                            <i class="fas fa-crown"></i>
                        }
                        else if (isManager)
                        {
                            <i class="fas fa-user-tie"></i> 
                        }
                        else
                        {
                            <i class="fas fa-user"></i>
                        }
                    </span>
                </div>
            }
        </div>
    </div>
    
    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <i class="fas fa-info-circle"></i>
            <strong>Limited Access:</strong> Please log in to view game details and access management features.
        </div>
    }
    
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-gamepad fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No games found</h4>
            <p class="text-muted">No PhotoRoulette games have been played yet.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="fas fa-code"></i> Game Code</th>
                                <th><i class="fas fa-users"></i> Players</th>
                                <th><i class="fas fa-layer-group"></i> Rounds</th>
                                <th><i class="fas fa-fire"></i> Excitement</th>
                                <th><i class="fas fa-calendar"></i> Created</th>
                                @if (isAuthenticated)
                                {
                                    <th><i class="fas fa-cogs"></i> Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var game in Model)
                            {
                                <tr id="game-row-@game.Id">
                                    <td>
                                        <span class="fw-bold text-primary">@game.Code</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@game.PlayersCollection.Count</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@game.RoundsCollection.Count</span>
                                    </td>
                                    <td>
                                        @{
                                            var excitementBadgeClass = "";
                                            var excitementText = "";
                                            var excitementIcon = "";
                                            
                                            switch (game.Excitement)
                                            {
                                                case Vjezba.Model.GameExcitement.VeryBoring:
                                                    excitementBadgeClass = "badge bg-danger";
                                                    excitementText = "Very Boring";
                                                    excitementIcon = "😴";
                                                    break;
                                                case Vjezba.Model.GameExcitement.Boring:
                                                    excitementBadgeClass = "badge bg-warning text-dark";
                                                    excitementText = "Boring";
                                                    excitementIcon = "😐";
                                                    break;
                                                case Vjezba.Model.GameExcitement.Average:
                                                    excitementBadgeClass = "badge bg-secondary";
                                                    excitementText = "Average";
                                                    excitementIcon = "🙂";
                                                    break;
                                                case Vjezba.Model.GameExcitement.Interesting:
                                                    excitementBadgeClass = "badge bg-info";
                                                    excitementText = "Interesting";
                                                    excitementIcon = "😊";
                                                    break;
                                                case Vjezba.Model.GameExcitement.Exciting:
                                                    excitementBadgeClass = "badge bg-success";
                                                    excitementText = "Exciting";
                                                    excitementIcon = "🤩";
                                                    break;
                                                case Vjezba.Model.GameExcitement.VeryExciting:
                                                    excitementBadgeClass = "badge bg-primary";
                                                    excitementText = "Very Exciting";
                                                    excitementIcon = "🔥";
                                                    break;
                                                default:
                                                    excitementBadgeClass = "badge bg-secondary";
                                                    excitementText = "Average";
                                                    excitementIcon = "🙂";
                                                    break;
                                            }
                                        }
                                        <span class="@excitementBadgeClass">@excitementIcon @excitementText</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@game.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                    </td>
                                    @if (isAuthenticated)
                                    {
                                        <td>
                                            <div class="btn-group" role="group">
                                                <!-- View button - Available for Manager and Admin -->
                                                @if (isManager || isAdmin)
                                                {
                                                    <a asp-action="GameFlow" asp-route-id="@game.Id" 
                                                       class="btn btn-sm btn-outline-primary" 
                                                       title="View game details">
                                                        <i class="fas fa-eye"></i> View
                                                    </a>
                                                }
                                                
                                                <!-- Edit button - Admin only -->
                                                @if (isAdmin)
                                                {
                                                    <a asp-action="EditGame" asp-route-id="@game.Id" 
                                                       class="btn btn-sm btn-outline-warning" 
                                                       title="Edit game">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    
                                                    <!-- Delete button - Admin only -->
                                                    <button class="btn btn-sm btn-outline-danger" 
                                                            onclick="deleteGame(@game.Id, '@game.Code')"
                                                            title="Delete game">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                            
                                            @if (!isManager && !isAdmin)
                                            {
                                                <span class="text-muted small">
                                                    <i class="fas fa-lock"></i> Limited access
                                                </span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Access Level Information -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="fas fa-info-circle text-info"></i> Access Levels
                        </h6>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="access-level">
                                    <strong><i class="fas fa-user text-secondary"></i> Not Logged In:</strong>
                                    <ul class="mb-0 small">
                                        <li>View games list only</li>
                                        <li>No access to details</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="access-level">
                                    <strong><i class="fas fa-user-tie text-info"></i> Manager:</strong>
                                    <ul class="mb-0 small">
                                        <li>View games list</li>
                                        <li>View game details</li>
                                        <li>Cannot edit or delete</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="access-level">
                                    <strong><i class="fas fa-crown text-warning"></i> Admin:</strong>
                                    <ul class="mb-0 small">
                                        <li>Full access</li>
                                        <li>View, edit, and delete</li>
                                        <li>Export game data</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Confirmation Modal for Game Deletion - Admin Only -->
@if (isAdmin)
{
    <div class="modal fade" id="deleteGameModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle"></i> Confirm Game Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-warning"></i>
                        <strong>Warning:</strong> This action cannot be undone!
                    </div>
                    <p>Are you sure you want to delete the game <strong id="gameToDelete"></strong>?</p>
                    <p class="text-danger">This will permanently remove:</p>
                    <ul class="text-danger">
                        <li>All game data</li>
                        <li>Player information</li>
                        <li>Round data and images</li>
                        <li>Player answers and scores</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteGameBtn">
                        <i class="fas fa-trash"></i> Delete Game
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (isAdmin)
{
    <script>
        let gameToDeleteId = null;

        function deleteGame(gameId, gameCode) {
            gameToDeleteId = gameId;
            document.getElementById('gameToDelete').textContent = gameCode;
            document.getElementById('confirmDeleteGameBtn').onclick = () => confirmDeleteGame(gameId, gameCode);
            new bootstrap.Modal(document.getElementById('deleteGameModal')).show();
        }

        function confirmDeleteGame(gameId, gameCode) {
            const button = document.getElementById('confirmDeleteGameBtn');
            
            // Disable button and show loading
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';

            fetch(`/api/GameApi/${gameId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Delete failed');
                }
                return response.json();
            })
            .then(data => {
                // Hide the game row with smooth animation
                const gameRow = document.getElementById(`game-row-${gameId}`);
                gameRow.style.transition = 'opacity 0.3s ease';
                gameRow.style.opacity = '0';
                
                setTimeout(() => {
                    gameRow.remove();
                    
                    // Check if table is now empty
                    const tableBody = document.querySelector('tbody');
                    if (tableBody.children.length === 0) {
                        // Replace table with "No games found" message
                        const container = document.querySelector('.container');
                        container.innerHTML = `
                            <div class="text-center py-5">
                                <i class="fas fa-gamepad fa-3x text-muted mb-3"></i>
                                <h4 class="text-muted">No games found</h4>
                                <p class="text-muted">No PhotoRoulette games have been played yet.</p>
                            </div>
                        `;
                    }
                }, 300);

                // Close modal
                bootstrap.Modal.getInstance(document.getElementById('deleteGameModal')).hide();
                
                // Show success message
                showAlert(`Game "${gameCode}" deleted successfully!`, 'success');
                
                // Reset button
                button.disabled = false;
                button.innerHTML = '<i class="fas fa-trash"></i> Delete Game';
            })
            .catch(error => {
                console.error('Delete error:', error);
                showAlert('Failed to delete game. Please try again.', 'danger');
                
                // Reset button
                button.disabled = false;
                button.innerHTML = '<i class="fas fa-trash"></i> Delete Game';
            });
        }

        // Utility function to show alerts
        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '9999';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);
            
            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.parentNode.removeChild(alertDiv);
                }
            }, 5000);
        }
    </script>
}

<style>
    .table tr {
        transition: opacity 0.3s ease;
    }
    
    .access-level {
        padding: 0.5rem;
        border-left: 3px solid #dee2e6;
        margin-bottom: 1rem;
    }
    
    .btn-group .btn {
        margin-right: 2px;
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }
</style>